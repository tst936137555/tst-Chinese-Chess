app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing（密钥与口令绝不入库）
android/key.properties
*.jks
*.keystore

# 引擎 / NNUE / 字体大文件不入库：由 tool/fetch_engine.ps1 按
# tool/engine_manifest.json 从上游官方 release 下载（上游不可用时回退
# 本仓库镜像 release engine-mirror）并做 SHA256 校验后放置；
# Android x86_64 引擎官方不发布，由 tool/build_android_engine.sh 编译。
# 详见 README「构建」
/pikafish.exe
/assets/engine/pikafish.nnue
# 完整字体不入库：仅作为 tool/subset_font.py 的子集化输入（生成 XqKai-
# Medium-subset.ttf 入库资产）；完整版可从上游 release 或本仓库 engine-mirror
# 镜像 release 下载，见 README「霞鹜文楷字体」
/assets/fonts/LXGWWenKai-Medium.ttf
# 子集化用的便携 Python 运行时（tool/subset_font.py 的本地工具链）
/tool/.python/
/android/app/src/main/jniLibs/arm64-v8a/libpikafish.so
/android/app/src/main/jniLibs/x86_64/libpikafish.so
# iOS 引擎 xcframework 由 tool/setup_ios_engine.sh 在 macOS 现场构建
/ios/EngineBin/
/macos/EngineBin/pikafish
# GPLv3 / NNUE 许可证全文：fetch 脚本从官方发布包取得（不入库），
# 作为 Flutter 资产（assets/licenses/）随各平台安装包分发
/assets/licenses/

# Trae 内部工作文档
.trae/documents/

# Widget Preview related
.widget_preview/
