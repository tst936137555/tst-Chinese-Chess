# 统一换行符策略：
# - 文本文件默认入库时统一为 LF（根治 autocrlf 导致的“假修改”）
* text=auto eol=lf

# Windows 专用脚本必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件（防止被换行符转换破坏）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.so binary
*.dll binary
*.exe binary
*.a binary
*.dylib binary
*.jar binary
*.zip binary
*.7z binary
*.gz binary
*.xcresult binary
*.xcarchive binary
